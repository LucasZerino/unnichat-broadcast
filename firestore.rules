rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() { return request.auth != null && resource.data.userId == request.auth.uid; }
    match /connections/{id} { allow read: if owner(); allow write: if false; }
    match /contacts/{id} { allow read: if owner(); allow write: if false; }
    match /broadcasts/{id} { allow read: if owner(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
